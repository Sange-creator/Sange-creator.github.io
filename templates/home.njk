{% extends 'layout.njk' %}
{% block content %}
<section class="intro intro-revised hero-layout" aria-labelledby="intro-title">
  <div class="hero-copy">
    <h1 id="intro-title">{{ profile.name }}</h1>
    <p class="hero-fieldline">{{ profile.professionalTitle }}</p>
    <p class="profile-credential">{{ profile.license }}</p>
    <div class="intro-copy">
      <p>My work spans wireless communications and machine learning. I co-developed and evaluated a cellular handover controller using Python and PyTorch. At Nepal Telecom, I gained practical exposure to GSM/LTE network operations.</p>
      <p>I’m seeking research assistant opportunities and funded graduate study for Fall 2027. I want to study how radio access networks adapt to changing conditions and how well models generalize to new network layouts.</p>
    </div>
    <div class="intro-actions" role="group" aria-label="Research and CV">
      <a class="primary-link" href="mailto:{{ profile.email }}">Email me</a>
      <a href="/assets/documents/Saange_Tamang_Academic_CV.pdf">Academic CV (PDF)</a>
    </div>
  </div>
  <aside class="hero-contact" aria-label="Profile and contact links">
    <img class="hero-portrait" src="/assets/images/saange-tamang.webp" width="{{ sizes['saange-tamang'].width }}" height="{{ sizes['saange-tamang'].height }}" alt="Portrait of Saange Tamang" fetchpriority="high">
    <div class="hero-contact-heading">
      <p>Paschimanchal Campus, Institute of Engineering<br>Tribhuvan University · Nepal</p>
    </div>
    <nav class="social-links" aria-label="Contact and social profiles">
      <a class="social-link" href="mailto:{{ profile.email }}">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3.5 5.5h17v13h-17z"/><path d="m4 6 8 6.5L20 6"/></svg>
        <span><strong>Email</strong><span>{{ profile.email }}</span></span>
      </a>
      <a class="social-link" href="{{ profile.linkedin }}">
        <svg class="brand-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5.2 8.7H2.1V21h3.1zM3.65 3a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6M21.9 13.9c0-3.7-2-5.5-4.7-5.5a4.1 4.1 0 0 0-3.7 2v-1.7h-3V21h3.1v-6.1c0-1.6.3-3.2 2.4-3.2 2 0 2.1 1.9 2.1 3.3V21h3.1z"/></svg>
        <span><strong>LinkedIn</strong><span>linkedin.com/in/saange-tamang</span></span>
      </a>
      <a class="social-link" href="{{ profile.github }}">
        <svg class="brand-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 .9a11.1 11.1 0 0 0-3.5 21.6c.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.8.1-.8.1-.8 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.7 1.3 3.3 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.2 0 4.4-2.7 5.4-5.3 5.7.4.3.8 1 .8 2v3c0 .3.2.6.8.5A11.1 11.1 0 0 0 12 .9Z"/></svg>
        <span><strong>GitHub</strong><span>github.com/Sange-creator</span></span>
      </a>
    </nav>
  </aside>
</section>

<section class="home-section featured-research" aria-labelledby="research-heading">
  <div class="section-heading"><h2 id="research-heading">Selected research</h2></div>
  <article class="section-body">
    <h3 class="publication-title"><a href="/research/">Graph learning for cellular handover</a></h3>
    <p class="status">First author with Sulav Kandel · {{ profile.paperStatus }}</p>
    <p>I contributed to the controller implementation, policy evaluation, validation, and manuscript. This study grew from our year-long LTE handover and load-balancing project.</p>
    <div class="inline-links">
      <a href="/research/">Study and results</a>
      <a href="/assets/documents/handover-study.pdf">Manuscript (PDF)</a>
      <a href="{{ profile.code }}">Research code</a>
    </div>
  </article>
</section>

<section class="home-section research-skills" aria-labelledby="skills-heading">
  <div class="section-heading"><h2 id="skills-heading">Research skills</h2></div>
  <dl class="research-skill-list">
    <div><dt>Model implementation</dt><dd>Python and PyTorch for graph attention and deep reinforcement learning. <a href="/research/#contribution-heading">Controller work</a></dd></div>
    <div><dt>Experiment design and analysis</dt><dd>Matched simulation cases, baseline comparisons, and paired analysis of throughput and mobility tradeoffs. <a href="/research/#evaluation-heading">Evaluation protocol</a></dd></div>
    <div><dt>Network configuration and analysis</dt><dd>IP connectivity, DHCP and DNS in Packet Tracer, and packet inspection in Wireshark. <a href="/projects/#computer-networks">Lab assignments</a></dd></div>
  </dl>
</section>

<section class="home-section interests research-directions" aria-labelledby="interests-heading">
  <div class="section-heading"><h2 id="interests-heading">Research interests</h2></div>
  <div class="interest-fields">
    <article class="interest-field">
      <h3>Wireless &amp; radio access networks</h3>
      <p>Wireless communications · 5G/6G · RAN · mobility management · cellular network optimization</p>
      <p>How do delayed signal and load measurements affect mobility decisions?</p>
    </article>
    <article class="interest-field">
      <h3>Artificial intelligence and machine learning</h3>
      <p>Machine learning · deep learning · neural networks · graph neural networks · reinforcement learning</p>
      <p>When do graph models generalize to network layouts they have never seen?</p>
    </article>
  </div>
</section>

<section class="home-section" id="experience" aria-labelledby="experience-heading">
  <div class="section-heading"><h2 id="experience-heading">Telecommunications experience</h2></div>
  <div class="section-body">
    <article class="entry">
      <div class="date-line"><h3>Nepal Telecom (NTC)</h3><span class="date">12 Jan – 27 Mar 2026</span></div>
      <p class="meta">Engineering Intern · Pokhara, Nepal</p>
      <p>Participated in handover and load-balancing activities, with exposure to GSM/LTE network planning, operation, optimization, and maintenance.</p>
    </article>
  </div>
</section>

<section class="home-section" aria-labelledby="projects-heading">
  <div class="section-heading"><h2 id="projects-heading">Projects &amp; practical work</h2><a href="/projects/">Project details and source</a></div>
  <div class="project-index">
    <article class="entry project-index-entry">
      <p class="project-type">Major project<span>2025–2026</span></p>
      <div>
      <h3><a href="/projects/#major-project">GNN-DQN Handover Optimization &amp; Load Balancing</a></h3>
      <p class="meta">One year, semesters 7–8 · Four-person team</p>
      <p>We explored graph-based reinforcement learning for LTE mobility and load balancing, then revised the work into a focused, two-author conference study of handover optimization.</p>
      </div>
    </article>
    <article class="entry project-index-entry">
      <p class="project-type">Minor project<span>Semester 6 · 2025</span></p>
      <div>
      <h3><a href="/projects/#solvote">SolVote</a></h3>
      <p>A collaborative engineering prototype for voter registration, Solana-based token issuance, and electronic voting.</p>
      </div>
    </article>
    <article class="entry project-index-entry">
      <p class="project-type">Side project<span>In development</span></p>
      <div>
      <h3><a href="/projects/#jamjamnepal">JAMJAMNEPAL — Tourism app</a></h3>
      <p>I’m developing a tourism application for domestic and international visitors to Nepal, building on a Go/Fiber and MongoDB foundation. AI integration is part of the planned development.</p>
      </div>
    </article>
    <article class="entry project-index-entry">
      <p class="project-type">Networking labs<span>Hands-on coursework</span></p>
      <div>
      <h3><a href="/projects/#computer-networks">Computer networks: configuration &amp; packet analysis</a></h3>
      <p>Cisco Packet Tracer and Wireshark assignments covering IP configuration, connectivity checks between networks, DHCP/DNS simulation, and packet capture and filtering.</p>
      </div>
    </article>
    <article class="entry project-index-entry">
      <p class="project-type">Software project<span>Swift · macOS</span></p>
      <div>
      <h3><a href="/projects/#clipboard-history">Clipboard History for macOS</a></h3>
      <p>A native menu-bar application for searching and reusing locally stored text clips, with keyboard shortcuts and no server requirement.</p>
      </div>
    </article>
  </div>
</section>

<section class="home-section" id="education" aria-labelledby="education-heading">
  <div class="section-heading"><h2 id="education-heading">Education</h2></div>
  <div class="section-body">
    <ol class="education-timeline" data-reveal aria-label="Education timeline">
    {% for education in profile.educationTimeline %}
      <li class="timeline-entry">
        <time class="timeline-period">{{ education.period }}</time>
        <div class="timeline-content">
          <h3>{{ education.heading }}</h3>
          {% if education.institution %}<p class="meta">{{ education.institution }}</p>{% endif %}
          {% if education.result %}<p class="timeline-result"><strong>{{ education.result }}</strong></p>{% endif %}
        </div>
      </li>
    {% endfor %}
    </ol>
    <p class="small-note qualification-note">{{ profile.license }}</p>
  </div>
</section>

<section class="home-section" aria-labelledby="courses-heading">
  <div class="section-heading"><h2 id="courses-heading">Continuing to learn</h2><p>Alongside projects and research</p></div>
  <div class="section-body">
    <ul class="course-list course-list-home">
      {% for course in profile.courses %}{% if loop.index <= 2 %}
      <li><a href="{{ course.url }}">{{ course.title }}</a><span class="meta">{{ course.issuer }} · Coursera · {{ course.date }}</span></li>
      {% endif %}{% endfor %}
    </ul>
    <p class="inline-links"><a href="/cv/#courses">All course credentials</a></p>
  </div>
</section>

{% endblock %}
