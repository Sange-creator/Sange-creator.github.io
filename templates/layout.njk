<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page.title }}</title>
  <meta name="description" content="{{ page.description }}">
  <meta name="author" content="Saange Tamang">
  {% if page.path == '/404.html' %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ profile.url }}{{ page.path }}">
  <link rel="icon" href="/favicon.ico?v=3" sizes="16x16 32x32 48x48">
  <link rel="icon" href="/assets/favicon.svg?v=3" type="image/svg+xml" sizes="any">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png?v=3" sizes="180x180">
  <link rel="preload" href="/assets/fonts/source-serif-4-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/style.css">
  <link rel="stylesheet" href="/assets/refinements.css">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page.title }}">
  <meta property="og:description" content="{{ page.description }}">
  <meta property="og:url" content="{{ profile.url }}{{ page.path }}">
  <meta property="og:image" content="{{ profile.url }}/assets/images/social-preview.png">
  <meta property="og:image:alt" content="Saange Tamang — Licensed Electronics, Communication and Information Engineer exploring wireless communications and AI/ML">
  <meta name="twitter:card" content="summary_large_image">
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"Person","name":"Saange Tamang","url":"https://sange-creator.github.io","image":"https://sange-creator.github.io/assets/images/saange-tamang.webp","sameAs":["https://github.com/Sange-creator","https://www.linkedin.com/in/saange-tamang/"],"alumniOf":{"@type":"CollegeOrUniversity","name":"Tribhuvan University"}}</script>
  <script src="/assets/site.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header shell">
    <a class="wordmark" href="/"{% if page.nav == 'home' %} aria-current="page"{% endif %}>Saange Tamang</a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="/research/"{% if page.nav == 'research' %} aria-current="page"{% endif %}>Research</a>
      <a href="/projects/"{% if page.nav == 'projects' %} aria-current="page"{% endif %}>Projects</a>
      <a href="/#experience">Experience</a>
      <a href="/#education">Education</a>
      <a href="/cv/"{% if page.nav == 'cv' %} aria-current="page"{% endif %}>CV</a>
    </nav>
  </header>
  <div class="page-grid shell">
    <main id="main" class="content-column">
      {% block content %}{% endblock %}
    </main>
  </div>
  <footer class="site-footer shell">
    <p>Saange Tamang · Nepal</p>
    <p>Updated {{ profile.updated }} · <a href="mailto:{{ profile.email }}">Email</a> · <a href="{{ profile.github }}/Sange-creator.github.io">Site source</a></p>
  </footer>
</body>
</html>
